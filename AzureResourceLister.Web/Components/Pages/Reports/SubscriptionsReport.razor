@page "/reports/subscriptions"
@using System.Globalization
@using System.Text
@inject ReportService ReportService
@inject IJSRuntime JS

<PageTitle>Subscriptions Report</PageTitle>

<h1>Subscriptions Report</h1>

<div class="filter-bar">
    <div class="filter-item">
        <label>Year:</label>
        <select @bind="_selectedYear" @bind:after="RunReportAsync">
            @foreach (var year in _filterOptions.Years)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>

    <div class="filter-item">
        <label>Month:</label>
        <select @bind="_selectedMonth" @bind:after="RunReportAsync">
            @foreach (var (num, name) in _months)
            {
                <option value="@num">@name</option>
            }
        </select>
    </div>

    <div class="filter-item">
        <label>Category:</label>
        <select @bind="_selectedCategory" @bind:after="RunReportAsync">
            <option value="">All Categories</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <div class="filter-item">
        <label>Cost Mode:</label>
        <select @bind="_costMode">
            <option value="Actual">Actual Cost</option>
            <option value="Payg">PAYG Cost</option>
            <option value="Both">Both (With Savings)</option>
        </select>
    </div>

    <button class="btn btn-export" @onclick="ExportCsvAsync" disabled="@_exporting">
        @(_exporting ? "Exporting..." : "⬇ Export CSV")
    </button>
</div>

@if (_loading)
{
    <p><em>Loading report...</em></p>
}
else if (_rows.Count == 0)
{
    <p class="no-data">No cost data found for the selected period/category.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subscription</th>
                <th>Environment</th>
                @if (_costMode == "Actual")
                {
                    <th class="col-cost">Actual Cost</th>
                }
                else if (_costMode == "Payg")
                {
                    <th class="col-cost">PAYG Cost</th>
                }
                else
                {
                    <th class="col-cost">Actual Cost</th>
                    <th class="col-cost">PAYG Cost</th>
                    <th class="col-cost">Savings</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td>@row.SubscriptionName</td>
                    <td>@row.EnvironmentName</td>
                    @if (_costMode == "Actual")
                    {
                        <td class="col-cost">@row.ActualCost.ToString("C2", _culture)</td>
                    }
                    else if (_costMode == "Payg")
                    {
                        <td class="col-cost">@row.PaygCost.ToString("C2", _culture)</td>
                    }
                    else
                    {
                        <td class="col-cost">@row.ActualCost.ToString("C2", _culture)</td>
                        <td class="col-cost">@row.PaygCost.ToString("C2", _culture)</td>
                        <td class="col-cost col-savings">@row.Savings.ToString("C2", _culture)</td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="grand-total-row">
                <td colspan="2"><strong>Grand Total</strong></td>
                @if (_costMode == "Actual")
                {
                    <td class="col-cost"><strong>@_grandTotalActual.ToString("C2", _culture)</strong></td>
                }
                else if (_costMode == "Payg")
                {
                    <td class="col-cost"><strong>@_grandTotalPayg.ToString("C2", _culture)</strong></td>
                }
                else
                {
                    <td class="col-cost"><strong>@_grandTotalActual.ToString("C2", _culture)</strong></td>
                    <td class="col-cost"><strong>@_grandTotalPayg.ToString("C2", _culture)</strong></td>
                    <td class="col-cost col-savings"><strong>@_grandTotalSavings.ToString("C2", _culture)</strong></td>
                }
            </tr>
        </tfoot>
    </table>
}

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("en-US");

    private ReportFilterOptions _filterOptions = new();
    private List<string> _categories = [];
    private List<(int Num, string Name)> _months = [];

    private int _selectedYear = DateTime.Today.Year;
    private int _selectedMonth = DateTime.Today.Month;
    private string _selectedCategory = string.Empty;
    private string _costMode = "Actual";

    private List<SubscriptionCostRow> _rows = [];
    private decimal _grandTotalActual;
    private decimal _grandTotalPayg;
    private decimal _grandTotalSavings;

    private bool _loading = true;
    private bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        _months = Enumerable.Range(1, 12)
            .Select(m => (m, DateTimeFormatInfo.CurrentInfo.GetMonthName(m)))
            .ToList();

        _filterOptions = await ReportService.GetFilterOptionsAsync();
        _categories = await ReportService.GetCategoriesAsync();

        if (_filterOptions.Years.Count > 0 && !_filterOptions.Years.Contains(_selectedYear))
        {
            _selectedYear = _filterOptions.Years[0];
        }

        await RunReportAsync();
    }

    private async Task RunReportAsync()
    {
        _loading = true;
        try
        {
            _rows = await ReportService.GetSubscriptionCostsAsync(
                _selectedYear,
                _selectedMonth,
                string.IsNullOrWhiteSpace(_selectedCategory) ? null : _selectedCategory);

            _grandTotalActual  = _rows.Sum(r => r.ActualCost);
            _grandTotalPayg    = _rows.Sum(r => r.PaygCost);
            _grandTotalSavings = _rows.Sum(r => r.Savings);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        _exporting = true;
        try
        {
            var sb = new StringBuilder();

            if (_costMode == "Actual")
            {
                sb.AppendLine(CsvRow(["Subscription", "Environment", "Actual Cost"]));
                foreach (var row in _rows)
                {
                    sb.AppendLine(CsvRow([
                        row.SubscriptionName,
                        row.EnvironmentName,
                        row.ActualCost.ToString("F2", CultureInfo.InvariantCulture)
                    ]));
                }
                sb.AppendLine(CsvRow(["Grand Total", "", _grandTotalActual.ToString("F2", CultureInfo.InvariantCulture)]));
            }
            else if (_costMode == "Payg")
            {
                sb.AppendLine(CsvRow(["Subscription", "Environment", "PAYG Cost"]));
                foreach (var row in _rows)
                {
                    sb.AppendLine(CsvRow([
                        row.SubscriptionName,
                        row.EnvironmentName,
                        row.PaygCost.ToString("F2", CultureInfo.InvariantCulture)
                    ]));
                }
                sb.AppendLine(CsvRow(["Grand Total", "", _grandTotalPayg.ToString("F2", CultureInfo.InvariantCulture)]));
            }
            else
            {
                sb.AppendLine(CsvRow(["Subscription", "Environment", "Actual Cost", "PAYG Cost", "Savings"]));
                foreach (var row in _rows)
                {
                    sb.AppendLine(CsvRow([
                        row.SubscriptionName,
                        row.EnvironmentName,
                        row.ActualCost.ToString("F2", CultureInfo.InvariantCulture),
                        row.PaygCost.ToString("F2", CultureInfo.InvariantCulture),
                        row.Savings.ToString("F2", CultureInfo.InvariantCulture)
                    ]));
                }
                sb.AppendLine(CsvRow([
                    "Grand Total",
                    "",
                    _grandTotalActual.ToString("F2", CultureInfo.InvariantCulture),
                    _grandTotalPayg.ToString("F2", CultureInfo.InvariantCulture),
                    _grandTotalSavings.ToString("F2", CultureInfo.InvariantCulture)
                ]));
            }

            var filename = $"subscriptions-report-{_selectedYear}-{_selectedMonth:D2}-{_costMode.ToLowerInvariant()}.csv";
            await JS.InvokeVoidAsync("downloadCsv", filename, sb.ToString());
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));
}
