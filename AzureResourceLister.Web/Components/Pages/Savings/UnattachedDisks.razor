@page "/savings/unattacheddisks"
@using System.Text
@inject UnattachedDiskFindingService FindingService
@inject IJSRuntime JS

<PageTitle>Unattached Disks — Saving Strategies</PageTitle>

<h1>Unattached Disks</h1>

<p class="page-description">
    Managed disks that are currently not attached to any VM, queried live from Azure.
    Azure charges for unattached disks at the same rate as attached ones.
    Monthly cost is sourced from the selected billing period.
</p>

<div class="filter-bar">
    <label class="filter-item">
        Year
        <select @bind="_year">
            @foreach (var y in _years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Month
        <select @bind="_month">
            @for (int m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@MonthName(month)</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
        @(_loading ? "Querying Azure..." : "Refresh from Azure")
    </button>
</div>

@* ── Subscription filter (appears after results are loaded) ───────────────── *@
@if (_hasRun && _subscriptions.Count > 1)
{
    <div class="sub-filter-bar">
        <label class="filter-item">
            Subscription
            <select @bind="_subscriptionFilter">
                <option value="">All subscriptions</option>
                @foreach (var s in _subscriptions)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_hasRun)
{
    <div class="finding-section">
        <div class="section-header">
            <h2>Unattached Managed Disks</h2>
            @if (!FilteredRows.Any())
            {
                <span class="badge badge-ok">&#10003; No unattached disks found</span>
            }
            else
            {
                <span class="badge badge-warn">
                    @FilteredRows.Count() disk(s) &nbsp;&middot;&nbsp;
                    @FilteredRows.Sum(r => r.DiskSizeGb) GB total &nbsp;&middot;&nbsp;
                    @FormatCost(FilteredRows.Sum(r => r.MonthlyCost))/mo
                </span>
                <button class="btn btn-export" @onclick="ExportCsvAsync">⬇ Export CSV</button>
            }
        </div>

        @if (FilteredRows.Any())
        {
            <p class="finding-note">
                Review each disk before deleting — some may be intentionally retained
                (e.g. backup staging, OS disk after VM deallocation). Delete via the
                Azure Portal or CLI: <code>az disk delete --name &lt;name&gt; --resource-group &lt;rg&gt;</code>
            </p>

            <table class="finding-table">
                <thead>
                    <tr>
                        <th>Disk Name</th>
                        <th>Resource Group</th>
                        <th>Subscription</th>
                        <th>Environment</th>
                        <th>Owner</th>
                        <th>Size</th>
                        <th>SKU</th>
                        <th>Monthly Cost</th>
                        <th>Annual Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        <tr>
                            <td>@row.ResourceName</td>
                            <td>@row.ResourceGroup</td>
                            <td>@row.SubscriptionName</td>
                            <td>@row.EnvironmentName</td>
                            <td>@row.OwnerName</td>
                            <td class="num">@row.DiskSizeGb GB</td>
                            <td>@row.SkuName</td>
                            <td class="cost">@FormatCost(row.MonthlyCost)</td>
                            <td class="cost">@FormatCost(row.MonthlyCost * 12)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5"><strong>Total</strong></td>
                        <td class="num"><strong>@FilteredRows.Sum(r => r.DiskSizeGb) GB</strong></td>
                        <td></td>
                        <td class="cost"><strong>@FormatCost(FilteredRows.Sum(r => r.MonthlyCost))</strong></td>
                        <td class="cost"><strong>@FormatCost(FilteredRows.Sum(r => r.MonthlyCost) * 12)</strong></td>
                    </tr>
                </tfoot>
            </table>

            <div class="summary-banner">
                Deleting all @(string.IsNullOrWhiteSpace(_subscriptionFilter) ? "" : "filtered ") unattached disks would save
                <strong class="saving-total">
                    @FormatCost(FilteredRows.Sum(r => r.MonthlyCost))/mo
                    &nbsp;&middot;&nbsp;
                    @FormatCost(FilteredRows.Sum(r => r.MonthlyCost) * 12)/yr
                </strong>
            </div>
        }
    </div>
}

@code {
    private List<int>               _years = [];
    private int                     _year;
    private int                     _month  = DateTime.Now.Month;
    private bool                    _loading;
    private bool                    _hasRun;
    private string?                 _error;
    private List<UnattachedDiskRow> _rows   = [];
    private List<string>            _subscriptions = [];
    private string                  _subscriptionFilter = string.Empty;

    private IEnumerable<UnattachedDiskRow> FilteredRows =>
        string.IsNullOrWhiteSpace(_subscriptionFilter)
            ? _rows
            : _rows.Where(r => r.SubscriptionName == _subscriptionFilter);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _years = await FindingService.GetAvailableYearsAsync();
            _year  = _years.Count > 0 ? _years[0] : DateTime.Now.Year;
        }
        catch (Exception ex) { _error = ex.Message; return; }

        await RunAsync();
    }

    private async Task RunAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        try
        {
            _rows   = await FindingService.GetUnattachedDisksAsync(_year, _month);
            _subscriptions = _rows.Select(r => r.SubscriptionName).Distinct().OrderBy(s => s).ToList();
            _subscriptionFilter = string.Empty;
            _hasRun = true;
        }
        catch (Exception ex) { _error = BuildErrorMessage(ex); }
        finally  { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow(["Disk Name", "Resource Group", "Subscription", "Environment", "Owner", "Size (GB)", "SKU", "Monthly Cost", "Annual Cost"]));

        foreach (var row in FilteredRows)
        {
            sb.AppendLine(CsvRow([
                row.ResourceName, row.ResourceGroup, row.SubscriptionName, row.EnvironmentName, row.OwnerName,
                row.DiskSizeGb.ToString(), row.SkuName,
                Math.Round(row.MonthlyCost, 0).ToString("N0"),
                Math.Round(row.MonthlyCost * 12, 0).ToString("N0"),
            ]));
        }

        await JS.InvokeVoidAsync("downloadCsv", $"unattached-disks-{_year}-{_month:D2}.csv", sb.ToString());
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));

    private static string FormatCost(decimal amount) =>
        "$" + Math.Round(amount, 0).ToString("N0");

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);

    private static string BuildErrorMessage(Exception ex)
    {
        var parts = new List<string>();
        var current = ex;
        while (current is not null) { parts.Add(current.Message); current = current.InnerException; }
        return string.Join(" -> ", parts);
    }
}
