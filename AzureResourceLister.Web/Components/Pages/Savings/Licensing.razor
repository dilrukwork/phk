@page "/savings/licensing"
@using System.Text
@inject LicenceFindingService FindingService
@inject IJSRuntime JS

<PageTitle>Licensing — Saving Strategies</PageTitle>

<h1>Licensing</h1>

<p class="page-description">
    VMs in <strong>Prod</strong> environments that are not using Azure Hybrid Benefit.
    Applying Hybrid Benefit to eligible VMs can save up to 49% on Windows Server and
    significantly reduce SQL Server licence costs.
</p>

<div class="filter-bar">
    <label class="filter-item">
        Year
        <select @bind="_year">
            @foreach (var y in _years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Month
        <select @bind="_month">
            @for (int m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@MonthName(month)</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
        @(_loading ? "Analysing..." : "Run Analysis")
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_hasRun)
{
    @* ── Windows Hybrid Benefit ───────────────────────────────────────────── *@
    <div class="finding-section">
        <div class="section-header">
            <h2>Windows VMs — Hybrid Benefit not applied</h2>
            @if (_windowsRows.Count == 0)
            {
                <span class="badge badge-ok">✓ No issues found</span>
            }
            else
            {
                <span class="badge badge-warn">@_windowsRows.Count VM(s) · @FormatCost(_windowsRows.Sum(r => r.MonthlyCost))/mo</span>
                <button class="btn btn-export" @onclick="ExportWindowsCsvAsync">⬇ Export CSV</button>
            }
        </div>

        <p class="finding-note">
            These VMs are billed at the Windows compute rate. Applying
            <a href="https://azure.microsoft.com/en-au/pricing/hybrid-benefit/" target="_blank">Azure Hybrid Benefit</a>
            using an existing Windows Server licence with Software Assurance can save up to 49%.
        </p>

        @if (_windowsRows.Count > 0)
        {
            <table class="finding-table">
                <thead>
                    <tr>
                        <th>Resource</th>
                        <th>Resource Group</th>
                        <th>Subscription</th>
                        <th>Owner</th>
                        <th>Licence Type</th>
                        <th>Monthly Cost</th>
                        <th>Est. Saving (49%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _windowsRows)
                    {
                        <tr>
                            <td>@row.ResourceName</td>
                            <td>@row.ResourceGroup</td>
                            <td>@row.SubscriptionName</td>
                            <td>@row.OwnerName</td>
                            <td>@row.LicenceType</td>
                            <td class="cost">@FormatCost(row.MonthlyCost)</td>
                            <td class="saving">@FormatCost(row.MonthlyCost * 0.49m)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5"><strong>Total</strong></td>
                        <td class="cost"><strong>@FormatCost(_windowsRows.Sum(r => r.MonthlyCost))</strong></td>
                        <td class="saving"><strong>@FormatCost(_windowsRows.Sum(r => r.MonthlyCost * 0.49m))</strong></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    @* ── SQL Server Hybrid Benefit ────────────────────────────────────────── *@
    <div class="finding-section">
        <div class="section-header">
            <h2>SQL Server VMs — Hybrid Benefit not applied</h2>
            @if (_sqlRows.Count == 0)
            {
                <span class="badge badge-ok">✓ No issues found</span>
            }
            else
            {
                <span class="badge badge-warn">@_sqlRows.Count VM(s) · @FormatCost(_sqlRows.Sum(r => r.MonthlyCost))/mo</span>
                <button class="btn btn-export" @onclick="ExportSqlCsvAsync">⬇ Export CSV</button>
            }
        </div>

        <p class="finding-note">
            These VMs are paying full PAYG SQL Server licence costs (Enterprise or Standard).
            Applying <a href="https://azure.microsoft.com/en-au/pricing/hybrid-benefit/" target="_blank">Azure Hybrid Benefit</a>
            using an existing SQL Server licence with Software Assurance eliminates this licence charge entirely.
            Developer and Express editions are excluded — they are already free.
        </p>

        @if (_sqlRows.Count > 0)
        {
            <table class="finding-table">
                <thead>
                    <tr>
                        <th>Resource</th>
                        <th>Resource Group</th>
                        <th>Subscription</th>
                        <th>Owner</th>
                        <th>Edition</th>
                        <th>Monthly Licence Cost</th>
                        <th>Est. Saving (100%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _sqlRows)
                    {
                        <tr>
                            <td>@row.ResourceName</td>
                            <td>@row.ResourceGroup</td>
                            <td>@row.SubscriptionName</td>
                            <td>@row.OwnerName</td>
                            <td>@row.LicenceType</td>
                            <td class="cost">@FormatCost(row.MonthlyCost)</td>
                            <td class="saving">@FormatCost(row.MonthlyCost)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5"><strong>Total</strong></td>
                        <td class="cost"><strong>@FormatCost(_sqlRows.Sum(r => r.MonthlyCost))</strong></td>
                        <td class="saving"><strong>@FormatCost(_sqlRows.Sum(r => r.MonthlyCost))</strong></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    @* ── Combined summary ─────────────────────────────────────────────────── *@
    @if (_windowsRows.Count > 0 || _sqlRows.Count > 0)
    {
        var totalSaving = _windowsRows.Sum(r => r.MonthlyCost * 0.49m)
                        + _sqlRows.Sum(r => r.MonthlyCost);
        <div class="summary-banner">
            Total estimated monthly saving if all Hybrid Benefits applied:
            <strong class="saving-total">@FormatCost(totalSaving)/mo &nbsp;·&nbsp; @FormatCost(totalSaving * 12)/yr</strong>
        </div>
    }
}

@code {
    private List<int> _years = [];
    private int  _year;
    private int  _month = DateTime.Now.Month;
    private bool _loading;
    private bool _hasRun;
    private string? _error;

    private List<LicenceFindingRow> _windowsRows = [];
    private List<LicenceFindingRow> _sqlRows     = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _years = await FindingService.GetAvailableYearsAsync();
            _year  = _years.Count > 0 ? _years[0] : DateTime.Now.Year;
        }
        catch (Exception ex) { _error = ex.Message; return; }

        await RunAsync();
    }

    private async Task RunAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        try
        {
            _windowsRows = await FindingService.GetWindowsHybridBenefitOpportunitiesAsync(_year, _month);
            _sqlRows     = await FindingService.GetSqlHybridBenefitOpportunitiesAsync(_year, _month);
            _hasRun      = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally  { _loading = false; }
    }

    private async Task ExportWindowsCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow(["Resource", "Resource Group", "Subscription", "Owner", "Licence Type", "Monthly Cost", "Est. Saving (49%)"]));

        foreach (var row in _windowsRows)
        {
            sb.AppendLine(CsvRow([
                row.ResourceName, row.ResourceGroup, row.SubscriptionName, row.OwnerName, row.LicenceType,
                Math.Round(row.MonthlyCost, 0).ToString("N0"),
                Math.Round(row.MonthlyCost * 0.49m, 0).ToString("N0"),
            ]));
        }

        await JS.InvokeVoidAsync("downloadCsv", $"licensing-windows-{_year}-{_month:D2}.csv", sb.ToString());
    }

    private async Task ExportSqlCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow(["Resource", "Resource Group", "Subscription", "Owner", "Edition", "Monthly Licence Cost", "Est. Saving (100%)"]));

        foreach (var row in _sqlRows)
        {
            sb.AppendLine(CsvRow([
                row.ResourceName, row.ResourceGroup, row.SubscriptionName, row.OwnerName, row.LicenceType,
                Math.Round(row.MonthlyCost, 0).ToString("N0"),
                Math.Round(row.MonthlyCost, 0).ToString("N0"),
            ]));
        }

        await JS.InvokeVoidAsync("downloadCsv", $"licensing-sql-{_year}-{_month:D2}.csv", sb.ToString());
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));

    private static string FormatCost(decimal amount) => "$" + Math.Round(amount, 0).ToString("N0");

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);
}
