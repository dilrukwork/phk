@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Azure Resource Lister</PageTitle>

<h1>Azure Resource Lister</h1>

<p>
    This page confirms the new solution structure is wired up correctly: the Blazor app
    is reading live data from the database through <code>AzureResourceLister.Core</code>.
</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        Could not reach the database: @_error
    </div>
}
else
{
    <table class="table">
        <tbody>
            <tr>
                <td>Applications</td>
                <td>@_applicationCount</td>
            </tr>
            <tr>
                <td>Business Owners</td>
                <td>@_ownerCount</td>
            </tr>
            <tr>
                <td>Resources</td>
                <td>@_resourceCount</td>
            </tr>
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _applicationCount;
    private int _ownerCount;
    private int _resourceCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            _applicationCount = await db.Applications.CountAsync();
            _ownerCount       = await db.BusinessOwners.CountAsync();
            _resourceCount    = await db.Resources.CountAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
