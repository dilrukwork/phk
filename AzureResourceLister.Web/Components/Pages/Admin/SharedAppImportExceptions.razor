@page "/admin/sharedappimportexceptions"
@using System.Text
@inject SharedAppExceptionAdminService AdminService
@inject IJSRuntime JS

<PageTitle>Shared App Import Exceptions</PageTitle>

<h1>Shared App Import Exceptions</h1>

<p>
    Shared-app registry rows whose resource (matched by name + resource group + subscription)
    wasn't found. Edit the details and hit Resync, or use Resync All to recheck everything
    against the Resource table as it stands now.
</p>

<div class="toolbar">
    <button class="btn btn-primary" @onclick="ResyncAllAsync" disabled="@_resyncingAll">
        @(_resyncingAll ? "Resyncing..." : "Resync All")
    </button>
</div>

@if (_status is not null)
{
    <p class="status-text">@_status</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="toolbar">
    <input class="form-input search-input"
           placeholder="Search by application or resource name..."
           @bind="_searchTerm"
           @bind:event="oninput"
           @onkeyup="OnSearchKeyUp" />
    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <button class="btn-link" @onclick="ClearSearchAsync">Clear</button>
    }
    <button class="btn btn-export" @onclick="ExportCsvAsync" disabled="@_exporting">
        @(_exporting ? "Exporting..." : "⬇ Export CSV")
    </button>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <p class="result-count">@_page.TotalCount total exception(s) — page @_page.PageNumber of @Math.Max(_page.TotalPages, 1)</p>

    <table class="table">
        <thead>
            <tr>
                <th>Application</th>
                <th>Owner</th>
                <th>Azure Resource ID</th>
                <th>Reason</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _page.Items)
            {
                <tr>
                    <td>@row.ApplicationName</td>
                    <td>@row.OwnerName</td>
                    <td><input class="form-input resource-id-input" @bind="_editedResourceId[row.Id]" /></td>
                    <td>@row.Reason</td>
                    <td>
                        <button class="btn-link" @onclick="() => ResyncAsync(row.Id)" disabled="@(_resyncingId == row.Id)">
                            @(_resyncingId == row.Id ? "Resyncing..." : "Resync")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn-link" disabled="@(_page.PageNumber <= 1)" @onclick="() => GoToPageAsync(_page.PageNumber - 1)">&laquo; Previous</button>
        <span>Page @_page.PageNumber of @Math.Max(_page.TotalPages, 1)</span>
        <button class="btn-link" disabled="@(_page.PageNumber >= _page.TotalPages)" @onclick="() => GoToPageAsync(_page.PageNumber + 1)">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 50;

    private PagedResult<SharedAppImportExceptionRow> _page = new();
    private Dictionary<int, string> _editedResourceId = [];
    private string _searchTerm = string.Empty;
    private bool _loading = true;
    private string? _error;
    private string? _status;

    private bool _resyncingAll;
    private int? _resyncingId;

    private bool _exporting;

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    private async Task LoadPageAsync(int pageNumber)
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await AdminService.GetPagedAsync(pageNumber, PageSize, _searchTerm);
            _editedResourceId = _page.Items.ToDictionary(r => r.Id, r => r.AzureResourceName);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GoToPageAsync(int pageNumber) => await LoadPageAsync(pageNumber);

    private async Task SearchAsync() => await LoadPageAsync(1);

    private async Task ClearSearchAsync()
    {
        _searchTerm = string.Empty;
        await LoadPageAsync(1);
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ResyncAsync(int exceptionId)
    {
        _resyncingId = exceptionId;
        _error = null;
        StateHasChanged();

        try
        {
            var azureResourceId = _editedResourceId.GetValueOrDefault(exceptionId, string.Empty);
            var (resolved, error) = await AdminService.ResyncAsync(exceptionId, azureResourceId);

            _status = resolved
                ? "Resolved — application linked to the resource."
                : $"Not resolved: {error}";

            await LoadPageAsync(_page.PageNumber);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _resyncingId = null;
        }
    }

    private async Task ResyncAllAsync()
    {
        _resyncingAll = true;
        _error = null;
        _status = "Resyncing all exceptions against the current Resource table...";
        StateHasChanged();

        try
        {
            var resolved = await AdminService.ResyncAllAsync();
            _status = $"Resync All complete — {resolved} exception(s) resolved.";
            await LoadPageAsync(1);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _resyncingAll = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        _exporting = true;
        StateHasChanged();

        try
        {
            var all = await AdminService.GetPagedAsync(1, int.MaxValue, _searchTerm);

            var sb = new StringBuilder();
            sb.AppendLine(CsvRow(["Application", "Owner", "Azure Resource ID", "Reason"]));

            foreach (var row in all.Items)
            {
                sb.AppendLine(CsvRow([row.ApplicationName, row.OwnerName, row.AzureResourceName, row.Reason]));
            }

            await JS.InvokeVoidAsync("downloadCsv", "shared-app-import-exceptions.csv", sb.ToString());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));
}
