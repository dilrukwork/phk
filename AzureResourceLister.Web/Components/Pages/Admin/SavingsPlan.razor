@page "/admin/savingsplan"
@using System.Text
@inject PriceSheetImportService ImportService
@inject SavingsPlanAdminService AdminService
@inject AppConfig Config
@inject IJSRuntime JS

<PageTitle>Savings Plan</PageTitle>

<h1>Savings Plan</h1>

<p class="page-description">
    Replays Azure's real hour-by-hour Savings Plan allocation across the selected month:
    each hour, eligible resources scheduled to be running (per their
    <strong>Hours of Operation</strong> — 24x7 or 5x12, from the <code>dxcAutoShutdownSchedule</code>
    tag) compete for your hourly commitment, highest discount first, until it's used up.
    At <strong>$0</strong> commitment nothing is covered, so all three cost columns match —
    raise the commitment and re-run to see the resulting saving, and try different amounts
    to find the optimum before locking in a term.
</p>

@* ── Price sheet import ───────────────────────────────────────────────────── *@
<div class="import-section">
    <div class="import-header">
        <h2>Price Sheet</h2>
        @if (_priceSheetCount > 0)
        {
            <span class="badge badge-ok">&#10003; @_priceSheetCount entries loaded</span>
        }
        else
        {
            <span class="badge badge-warn">Not imported — import before running analysis</span>
        }
    </div>
    <p class="import-note">
        Import your Azure price sheet CSV to identify Savings Plan rates.
        Only SavingsPlan rows are kept (Consumption rows are excluded).
        Reads from: <code>@Config.PriceSheetPath</code>
    </p>
    <div class="import-bar">
        <button class="btn btn-primary" @onclick="ImportPriceSheetAsync" disabled="@_importing">
            @(_importing ? "Importing..." : "Import Price Sheet")
        </button>
        @if (_importStatus is not null)
        {
            <span class="import-status">@_importStatus</span>
        }
    </div>
    @if (_importError is not null)
    {
        <div class="alert alert-danger">@_importError</div>
    }
</div>

@* ── Excluded Resources panel ─────────────────────────────────────────────── *@
@if (_excludedResources.Count > 0)
{
    <div class="excluded-panel">
        <div class="excluded-header">
            <span>Excluded from Savings Plan (@_excludedResources.Count)</span>
        </div>
        <ul class="excluded-list">
            @foreach (var ex in _excludedResources)
            {
                <li>
                    <span>@ex.ResourceName <span class="excluded-meta">(@ex.ResourceGroup, @ex.SubscriptionName)</span></span>
                    <button class="btn-link" @onclick="() => IncludeResourceAsync(ex.ResourceId)">Include</button>
                </li>
            }
        </ul>
    </div>
}

@* ── Filters + commitment input ───────────────────────────────────────────── *@
<div class="filter-bar">
    <label class="filter-item">
        Year
        <select @bind="_year">
            @foreach (var y in _years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Month
        <select @bind="_month">
            @for (int m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@MonthName(month)</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Subscription
        <select @bind="_subscriptionFilter">
            <option value="">Select a subscription...</option>
            @foreach (var s in _subscriptions)
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Type
        <select @bind="_typeFilter">
            <option value="">All types</option>
            @foreach (var t in _meterCategories)
            {
                <option value="@t">@t</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Hourly Commitment ($)
        <input type="number" min="0" step="0.01" class="commitment-input" @bind="_hourlyCommitment" />
    </label>

    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
        @(_loading ? "Calculating..." : "Run Analysis")
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@* ── Results ──────────────────────────────────────────────────────────────── *@
@if (_hasRun)
{
    @if (_rows.Count == 0)
    {
        <p class="no-data">
            @if (_priceSheetCount == 0)
            {
                <text>Import the price sheet first, then run the analysis.</text>
            }
            else
            {
                <text>No OnDemand resources found for the selected period, subscription, and type.</text>
            }
        </p>
    }
    else
    {
        <div class="result-summary">
            At <strong>@FormatCost(_hourlyCommitment)</strong>/hour commitment:
            &nbsp;Total PAYG: <strong>@FormatCost(_rows.Sum(r => r.MonthlyCost))</strong>
            &nbsp;·&nbsp; With P1Y: <strong>@FormatCost(_rows.Sum(r => r.CostWithP1Y))</strong>
            (saves @FormatCost(_rows.Sum(r => r.SavingP1Y)))
            &nbsp;·&nbsp; With P3Y: <strong>@FormatCost(_rows.Sum(r => r.CostWithP3Y))</strong>
            (saves @FormatCost(_rows.Sum(r => r.SavingP3Y)))
            &nbsp;·&nbsp; <button class="btn btn-export" @onclick="ExportCsvAsync">⬇ Export CSV</button>
        </div>

        <table class="sp-table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Type</th>
                    <th>Meter</th>
                    <th>Schedule</th>
                    <th>Monthly Cost (PAYG)</th>
                    <th>Cost with P1Y</th>
                    <th>Saving (P1Y)</th>
                    <th>Cost with P3Y</th>
                    <th>Saving (P3Y)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var appTitle = string.IsNullOrWhiteSpace(row.ApplicationNames) ? "No application linked" : row.ApplicationNames;
                    <tr>
                        <td title="@appTitle">
                            @row.ResourceName
                            <div class="app-subtitle">@(string.IsNullOrWhiteSpace(row.ApplicationNames) ? "—" : row.ApplicationNames)</div>
                        </td>
                        <td>@row.MeterCategory</td>
                        <td>@row.MeterSubCategory — @row.MeterName</td>
                        <td>@row.HoursOfOperation</td>
                        <td class="cost">@FormatCost(row.MonthlyCost)</td>
                        <td class="cost">@FormatCost(row.CostWithP1Y)</td>
                        <td class="saving">@FormatCost(row.SavingP1Y) (@Math.Round(row.SavingP1YPercent, 0)%)</td>
                        <td class="cost">@FormatCost(row.CostWithP3Y)</td>
                        <td class="saving">@FormatCost(row.SavingP3Y) (@Math.Round(row.SavingP3YPercent, 0)%)</td>
                        <td><button class="btn-link btn-exclude" @onclick="() => ExcludeResourceAsync(row.ResourceId)">Exclude</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4"><strong>Total</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.MonthlyCost))</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.CostWithP1Y))</strong></td>
                    <td class="saving"><strong>@FormatCost(_rows.Sum(r => r.SavingP1Y))</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.CostWithP3Y))</strong></td>
                    <td class="saving"><strong>@FormatCost(_rows.Sum(r => r.SavingP3Y))</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
}

@code {
    private List<int>    _years           = [];
    private List<string> _subscriptions   = [];
    private List<string> _meterCategories = [];
    private int     _year;
    private int     _month              = DateTime.Now.Month;
    private string  _subscriptionFilter = string.Empty;
    private string  _typeFilter         = string.Empty;
    private decimal _hourlyCommitment   = 0m;

    private bool    _loading;
    private bool    _hasRun;
    private string? _error;
    private List<SavingsPlanSimulationRow> _rows = [];

    private bool    _importing;
    private string? _importStatus;
    private string? _importError;
    private int     _priceSheetCount;

    private List<ExcludedResourceRow> _excludedResources = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _priceSheetCount    = await ImportService.GetEntryCountAsync();
            _years              = await AdminService.GetAvailableYearsAsync();
            _subscriptions      = await AdminService.GetSubscriptionsAsync();
            _meterCategories    = await AdminService.GetMeterCategoriesAsync();
            _excludedResources  = await AdminService.GetExcludedResourcesAsync();
            _year               = _years.Count > 0 ? _years[0] : DateTime.Now.Year;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ImportPriceSheetAsync()
    {
        _importing    = true;
        _importError  = null;
        _importStatus = "Importing...";
        StateHasChanged();

        try
        {
            var summary = await ImportService.ImportAsync(Config.PriceSheetPath);
            _priceSheetCount = summary.EntriesImported;
            _importStatus    = $"Imported {summary.EntriesImported} Savings Plan entries across " +
                               $"{summary.DistinctMeters} distinct meters. " +
                               $"{summary.ConsumptionSkipped} Consumption rows skipped.";

            _meterCategories = await AdminService.GetMeterCategoriesAsync();
        }
        catch (Exception ex)
        {
            _importError  = ex.Message;
            _importStatus = null;
        }
        finally { _importing = false; }
    }

    private async Task RunAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_subscriptionFilter))
        {
            _error = "Select a Subscription before running the analysis — a Savings Plan commitment is scoped per subscription.";
            return;
        }

        if (_hourlyCommitment < 0)
        {
            _error = "Hourly commitment must be zero or greater.";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            _rows   = await AdminService.RunHourlyCommitmentSimulationAsync(
                _year, _month, _subscriptionFilter, _typeFilter, _hourlyCommitment);
            _hasRun = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    /// <summary>Permanently excludes a resource, then re-runs so remaining resources show
    /// their true updated figures (excluding one changes how much commitment is left for
    /// everyone else in every hour it would have competed for).</summary>
    private async Task ExcludeResourceAsync(int resourceId)
    {
        try
        {
            await AdminService.SetSavingsPlanExclusionAsync(resourceId, true);
            _excludedResources = await AdminService.GetExcludedResourcesAsync();
            if (_hasRun) await RunAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task IncludeResourceAsync(int resourceId)
    {
        try
        {
            await AdminService.SetSavingsPlanExclusionAsync(resourceId, false);
            _excludedResources = await AdminService.GetExcludedResourcesAsync();
            if (_hasRun) await RunAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow([
            "Resource", "Type", "Meter", "Schedule", "Monthly Cost (PAYG)",
            "Cost with P1Y", "Saving (P1Y)", "Cost with P3Y", "Saving (P3Y)"
        ]));

        foreach (var row in _rows)
        {
            sb.AppendLine(CsvRow([
                row.ResourceName,
                row.MeterCategory,
                $"{row.MeterSubCategory} — {row.MeterName}",
                row.HoursOfOperation,
                Math.Round(row.MonthlyCost, 0).ToString("N0"),
                Math.Round(row.CostWithP1Y, 0).ToString("N0"),
                Math.Round(row.SavingP1Y, 0).ToString("N0"),
                Math.Round(row.CostWithP3Y, 0).ToString("N0"),
                Math.Round(row.SavingP3Y, 0).ToString("N0"),
            ]));
        }

        await JS.InvokeVoidAsync("downloadCsv", $"savings-plan-{_year}-{_month:D2}.csv", sb.ToString());
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));

    private static string FormatCost(decimal amount) =>
        "$" + Math.Round(amount, 0).ToString("N0");

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);
}
