@page "/admin/resourcecosts"
@inject BillingImportService ImportService
@inject AppConfig Config

<PageTitle>Resource Costs</PageTitle>

<h1>Resource Costs</h1>

<p>
    Imports the billing sheet at <code>@Config.BillingSheetPath</code> into ResourceCost.
    Anything that doesn't match a known resource goes to Cost Exceptions instead.
</p>

<div class="toolbar">
    <button class="btn btn-primary" @onclick="ImportAsync" disabled="@_importing">
        @(_importing ? "Importing..." : "Import Resource Costs")
    </button>
</div>

@if (_status is not null)
{
    <p class="status-text">@_status</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@code {
    private bool _importing;
    private string? _status;
    private string? _error;

    private async Task ImportAsync()
    {
        _importing = true;
        _error = null;
        _status = "Importing...";
        StateHasChanged();

        try
        {
            var summary = await ImportService.SyncResourceCostsAsync(Config.BillingSheetPath);

            _status = $"Import successful — {summary.CostsInserted} cost row(s) imported, " +
                      $"{summary.MetersInserted} new meter(s), " +
                      $"{summary.OtherSubscriptionRowsSkipped} row(s) skipped (other subscriptions)" +
                      (summary.ResourcesCreatedFromCostSheet > 0
                          ? $", {summary.ResourcesCreatedFromCostSheet} resource(s) reconstructed from the cost sheet (deleted in Azure)"
                          : "") +
                      (summary.ExceptionsLogged > 0
                          ? $", {summary.ExceptionsLogged} exception(s) logged — see the Cost Exceptions page."
                          : ".");
        }
        catch (Exception ex)
        {
            _error = BuildErrorMessage(ex);
            _status = null;
        }
        finally
        {
            _importing = false;
        }
    }

    /// <summary>Walks the full exception chain so EF Core's inner SQL exception is visible in the UI.</summary>
    private static string BuildErrorMessage(Exception ex)
    {
        var parts = new List<string>();
        var current = ex;
        while (current is not null)
        {
            if (!string.IsNullOrWhiteSpace(current.Message))
                parts.Add(current.Message);
            current = current.InnerException;
        }
        return string.Join(" → ", parts);
    }
}
