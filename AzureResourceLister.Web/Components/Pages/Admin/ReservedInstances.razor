@page "/admin/reservedinstances"
@using System.Text
@inject ReservedInstanceImportService ImportService
@inject ReservedInstanceAdminService AdminService
@inject AppConfig Config
@inject IJSRuntime JS

<PageTitle>Reserved Instances</PageTitle>

<h1>Reserved Instances</h1>

<p class="page-description">
    Compares on-demand cost against 1-year and 3-year Reserved Instance pricing for eligible
    resources. On-demand uses the same schedule-aware calculation as Savings Plan — a
    <strong>5x12</strong> resource shows a lower on-demand figure than a 24x7 one on the same
    meter. Reserved pricing is flat (<code>term price ÷ 12</code> or <code>÷ 36</code>) and
    deliberately ignores schedule — a reservation is billed whether the resource runs or not.
    That's what lets this page show when a reservation may not be worthwhile for a resource
    that isn't running most of the time.
</p>

@* ── Price sheet import ───────────────────────────────────────────────────── *@
<div class="import-section">
    <div class="import-header">
        <h2>Reserved Instance Price Sheet</h2>
        @if (_priceSheetCount > 0)
        {
            <span class="badge badge-ok">&#10003; @_priceSheetCount entries loaded</span>
        }
        else
        {
            <span class="badge badge-warn">Not imported — import before running analysis</span>
        }
    </div>
    <p class="import-note">
        Import a dedicated Reserved Instance price sheet CSV — a separate file from the
        Savings Plan price sheet, containing only Reserved Instance rows.
        Reads from: <code>@Config.ReservedInstancePriceSheetPath</code>
    </p>
    <div class="import-bar">
        <button class="btn btn-primary" @onclick="ImportPriceSheetAsync" disabled="@_importing">
            @(_importing ? "Importing..." : "Import Price Sheet")
        </button>
        @if (_importStatus is not null)
        {
            <span class="import-status">@_importStatus</span>
        }
    </div>
    @if (_importError is not null)
    {
        <div class="alert alert-danger">@_importError</div>
    }
</div>

@* ── Filters ──────────────────────────────────────────────────────────────── *@
<div class="filter-bar">
    <label class="filter-item">
        Year
        <select @bind="_year">
            @foreach (var y in _years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Month
        <select @bind="_month">
            @for (int m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@MonthName(month)</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Subscription
        <select @bind="_subscriptionFilter">
            <option value="">Select a subscription...</option>
            @foreach (var s in _subscriptions)
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>

    <label class="filter-item">
        Type
        <select @bind="_typeFilter">
            <option value="">All types</option>
            @foreach (var t in _meterCategories)
            {
                <option value="@t">@t</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
        @(_loading ? "Calculating..." : "Run Analysis")
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@* ── Results ──────────────────────────────────────────────────────────────── *@
@if (_hasRun)
{
    @if (_rows.Count == 0)
    {
        <p class="no-data">
            @if (_priceSheetCount == 0)
            {
                <text>Import the Reserved Instance price sheet first, then run the analysis.</text>
            }
            else
            {
                <text>No eligible resources found for the selected period, subscription, and type.</text>
            }
        </p>
    }
    else
    {
        <div class="result-summary">
            Total on-demand: <strong>@FormatCost(_rows.Sum(r => r.OnDemandMonthly))</strong>
            &nbsp;·&nbsp; With 1Y: <strong>@FormatCost(_rows.Sum(r => r.Reserved1YMonthly ?? 0))</strong>
            &nbsp;·&nbsp; With 3Y: <strong>@FormatCost(_rows.Sum(r => r.Reserved3YMonthly ?? 0))</strong>
            &nbsp;·&nbsp; <button class="btn btn-export" @onclick="ExportCsvAsync">⬇ Export CSV</button>
        </div>

        <table class="sp-table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Type</th>
                    <th>Meter</th>
                    <th>Schedule</th>
                    <th>On-demand /mo</th>
                    <th>1Y Reserved /mo</th>
                    <th>Saving (1Y)</th>
                    <th>3Y Reserved /mo</th>
                    <th>Saving (3Y)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var appTitle = string.IsNullOrWhiteSpace(row.ApplicationNames) ? "No application linked" : row.ApplicationNames;
                    <tr>
                        <td title="@appTitle">
                            @row.ResourceName
                            <div class="app-subtitle">@(string.IsNullOrWhiteSpace(row.ApplicationNames) ? "—" : row.ApplicationNames)</div>
                        </td>
                        <td>@row.MeterCategory</td>
                        <td>@row.MeterSubCategory — @row.MeterName</td>
                        <td>@row.HoursOfOperation</td>
                        <td class="cost">@FormatCost(row.OnDemandMonthly)</td>
                        <td class="cost">@(row.Reserved1YMonthly.HasValue ? FormatCost(row.Reserved1YMonthly.Value) : "—")</td>
                        <td class="saving">@FormatSaving(row.Saving1Y, row.Saving1YPercent)</td>
                        <td class="cost">@(row.Reserved3YMonthly.HasValue ? FormatCost(row.Reserved3YMonthly.Value) : "—")</td>
                        <td class="saving">@FormatSaving(row.Saving3Y, row.Saving3YPercent)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4"><strong>Total</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.OnDemandMonthly))</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.Reserved1YMonthly ?? 0))</strong></td>
                    <td class="saving"><strong>@FormatCost(_rows.Sum(r => r.Saving1Y ?? 0))</strong></td>
                    <td class="cost"><strong>@FormatCost(_rows.Sum(r => r.Reserved3YMonthly ?? 0))</strong></td>
                    <td class="saving"><strong>@FormatCost(_rows.Sum(r => r.Saving3Y ?? 0))</strong></td>
                </tr>
            </tfoot>
        </table>
    }
}

@code {
    private List<int>    _years           = [];
    private List<string> _subscriptions   = [];
    private List<string> _meterCategories = [];
    private int     _year;
    private int     _month              = DateTime.Now.Month;
    private string  _subscriptionFilter = string.Empty;
    private string  _typeFilter         = string.Empty;

    private bool    _loading;
    private bool    _hasRun;
    private string? _error;
    private List<ReservedInstanceSimulationRow> _rows = [];

    private bool    _importing;
    private string? _importStatus;
    private string? _importError;
    private int     _priceSheetCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _priceSheetCount = await ImportService.GetEntryCountAsync();
            _years           = await AdminService.GetAvailableYearsAsync();
            _subscriptions   = await AdminService.GetSubscriptionsAsync();
            _meterCategories = await AdminService.GetMeterCategoriesAsync();
            _year            = _years.Count > 0 ? _years[0] : DateTime.Now.Year;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ImportPriceSheetAsync()
    {
        _importing    = true;
        _importError  = null;
        _importStatus = "Importing...";
        StateHasChanged();

        try
        {
            var summary = await ImportService.ImportAsync(Config.ReservedInstancePriceSheetPath);
            _priceSheetCount = summary.EntriesImported;
            _importStatus    = $"Imported {summary.EntriesImported} Reserved Instance entries across " +
                               $"{summary.DistinctMeters} distinct meters. " +
                               $"{summary.RowsSkipped} non-matching rows skipped.";

            _meterCategories = await AdminService.GetMeterCategoriesAsync();
        }
        catch (Exception ex)
        {
            _importError  = ex.Message;
            _importStatus = null;
        }
        finally { _importing = false; }
    }

    private async Task RunAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_subscriptionFilter))
        {
            _error = "Select a Subscription before running the analysis.";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            _rows   = await AdminService.GetComparisonAsync(_year, _month, _subscriptionFilter, _typeFilter);
            _hasRun = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow([
            "Resource", "Type", "Meter", "Schedule", "On-demand /mo",
            "1Y Reserved /mo", "Saving (1Y)", "3Y Reserved /mo", "Saving (3Y)"
        ]));

        foreach (var row in _rows)
        {
            sb.AppendLine(CsvRow([
                row.ResourceName,
                row.MeterCategory,
                $"{row.MeterSubCategory} — {row.MeterName}",
                row.HoursOfOperation,
                Math.Round(row.OnDemandMonthly, 0).ToString("N0"),
                row.Reserved1YMonthly.HasValue ? Math.Round(row.Reserved1YMonthly.Value, 0).ToString("N0") : "",
                row.Saving1Y.HasValue ? Math.Round(row.Saving1Y.Value, 0).ToString("N0") : "",
                row.Reserved3YMonthly.HasValue ? Math.Round(row.Reserved3YMonthly.Value, 0).ToString("N0") : "",
                row.Saving3Y.HasValue ? Math.Round(row.Saving3Y.Value, 0).ToString("N0") : "",
            ]));
        }

        await JS.InvokeVoidAsync("downloadCsv", $"reserved-instances-{_year}-{_month:D2}.csv", sb.ToString());
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));

    private static string FormatCost(decimal amount) =>
        "$" + Math.Round(amount, 0).ToString("N0");

    private static string FormatSaving(decimal? saving, decimal? percent)
    {
        if (!saving.HasValue) return "—";
        return $"{FormatCost(saving.Value)} ({Math.Round(percent ?? 0, 0)}%)";
    }

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);
}
