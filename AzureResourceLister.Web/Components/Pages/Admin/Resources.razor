@page "/admin/resources"
@using System.Text
@inject ResourceAdminService AdminService
@inject ResourceImportService ImportService
@inject SubscriptionLookupService SubscriptionLookup
@inject IJSRuntime JS

<PageTitle>Resources</PageTitle>

<h1>Resources</h1>

<div class="toolbar">
    <label class="subscription-label">
        Subscription:
        <select class="form-input subscription-select" @bind="_selectedSubscriptionId">
            <option value="@ResourceImportService.AllSubscriptions">All subscriptions</option>
            @foreach (var sub in _subscriptions)
            {
                <option value="@sub.AzureSubscriptionId">@sub.SubscriptionName</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="RefreshFromAzure" disabled="@_refreshing">
        @(_refreshing ? "Refreshing..." : "Refresh from Azure")
    </button>
</div>

@if (_refreshStatus is not null)
{
    <p class="status-text">@_refreshStatus</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="toolbar">
    <input class="form-input search-input"
           placeholder="Search by name, resource group, or resource ID..."
           @bind="_searchTerm"
           @bind:event="oninput"
           @onkeyup="OnSearchKeyUp" />

    <label class="subscription-label">
        Category:
        <select class="form-input" @bind="_selectedCategory" @bind:after="SearchAsync">
            <option value="">All Categories</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </label>

    <label class="subscription-label">
        Source:
        <select class="form-input" @bind="_selectedSource" @bind:after="SearchAsync">
            <option value="">All Sources</option>
            @foreach (var src in _sources)
            {
                <option value="@src">@src</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
    @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_selectedCategory) || !string.IsNullOrWhiteSpace(_selectedSource))
    {
        <button class="btn-link" @onclick="ClearSearchAsync">Clear</button>
    }
    <button class="btn btn-export" @onclick="ExportCsvAsync" disabled="@_exporting">
        @(_exporting ? "Exporting..." : "⬇ Export CSV")
    </button>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <p class="result-count">@_page.TotalCount total resource(s) — page @_page.PageNumber of @Math.Max(_page.TotalPages, 1)</p>

    <table class="table">
        <thead>
            <tr>
                <th>Resource Name</th>
                <th>Resource Group</th>
                <th>Subscription</th>
                <th>Application</th>
                <th>Owner</th>
                <th>Cost Centre</th>
                <th>Hours of Operation</th>
                <th>Status</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _page.Items)
            {
                <tr>
                    <td>@row.ResourceName</td>
                    <td>@row.ResourceGroup</td>
                    <td>@row.SubscriptionName</td>
                    <td>@row.ApplicationName</td>
                    <td>@row.OwnerName</td>
                    <td>@row.CostCentre</td>
                    <td>
                        <select class="form-input" value="@row.HoursOfOperation" @onchange="e => UpdateHoursOfOperationAsync(row, e.Value?.ToString())">
                            <option value="24x7">24x7</option>
                            <option value="5x12">5x12</option>
                        </select>
                    </td>
                    <td>
                        @if (row.IsActive)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>@row.Source</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn-link" disabled="@(_page.PageNumber <= 1)" @onclick="() => GoToPageAsync(_page.PageNumber - 1)">&laquo; Previous</button>
        <span>Page @_page.PageNumber of @Math.Max(_page.TotalPages, 1)</span>
        <button class="btn-link" disabled="@(_page.PageNumber >= _page.TotalPages)" @onclick="() => GoToPageAsync(_page.PageNumber + 1)">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 50;

    private PagedResult<ResourceRow> _page = new();
    private List<SubscriptionOption> _subscriptions = [];
    private List<string> _categories = [];
    private List<string> _sources = [];
    private string _selectedSubscriptionId = ResourceImportService.AllSubscriptions;
    private string _selectedCategory = string.Empty;
    private string _selectedSource = string.Empty;
    private string _searchTerm = string.Empty;
    private bool _loading = true;
    private string? _error;

    private bool _refreshing;
    private string? _refreshStatus;

    private bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _subscriptions = await SubscriptionLookup.GetAllAsync();
            _categories = await AdminService.GetCategoriesAsync();
            _sources = await AdminService.GetSourcesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int pageNumber)
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await AdminService.GetPagedAsync(
                pageNumber,
                PageSize,
                _searchTerm,
                string.IsNullOrWhiteSpace(_selectedCategory) ? null : _selectedCategory,
                string.IsNullOrWhiteSpace(_selectedSource) ? null : _selectedSource);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GoToPageAsync(int pageNumber) => await LoadPageAsync(pageNumber);

    private async Task SearchAsync() => await LoadPageAsync(1);

    private async Task ClearSearchAsync()
    {
        _searchTerm = string.Empty;
        _selectedCategory = string.Empty;
        _selectedSource = string.Empty;
        await LoadPageAsync(1);
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task RefreshFromAzure()
    {
        _refreshing = true;
        _error = null;
        _refreshStatus = "Fetching resources from Azure — this can take a while for a large subscription...";
        StateHasChanged();

        try
        {
            var summary = await ImportService.ImportAsync(_selectedSubscriptionId);

            var unresolvedNote = (summary.UnresolvedApplicationCount, summary.UnresolvedOwnerCount) switch
            {
                (0, 0) => "",
                (var a, 0) => $" {a} resource(s) fell back to Unassigned Application — curate those tag values on the Applications page, then refresh again.",
                (0, var o) => $" {o} resource(s) fell back to Unassigned Owner — curate those tag values on the Owners page, then refresh again.",
                (var a, var o) => $" {a} fell back to Unassigned Application, {o} to Unassigned Owner — curate on the Applications/Owners pages, then refresh again.",
            };

            _refreshStatus = $"{summary.Inserted} new, {summary.Updated} updated.{unresolvedNote}";
            await LoadPageAsync(1);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _refreshStatus = null;
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task UpdateHoursOfOperationAsync(ResourceRow row, string? newValue)
    {
        if (string.IsNullOrWhiteSpace(newValue)) return;
        try
        {
            await AdminService.UpdateHoursOfOperationAsync(row.Id, newValue);
            row.HoursOfOperation = newValue;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ExportCsvAsync()
    {
        _exporting = true;
        StateHasChanged();

        try
        {
            var all = await AdminService.GetPagedAsync(
                1,
                int.MaxValue,
                _searchTerm,
                string.IsNullOrWhiteSpace(_selectedCategory) ? null : _selectedCategory,
                string.IsNullOrWhiteSpace(_selectedSource) ? null : _selectedSource);

            var sb = new StringBuilder();
            sb.AppendLine(CsvRow([
                "Resource Name", "Resource Group", "Subscription", "Application",
                "Owner", "Cost Centre", "Hours of Operation", "Status", "Source"
            ]));

            foreach (var row in all.Items)
            {
                sb.AppendLine(CsvRow([
                    row.ResourceName, row.ResourceGroup, row.SubscriptionName, row.ApplicationName,
                    row.OwnerName, row.CostCentre, row.HoursOfOperation,
                    row.IsActive ? "Active" : "Inactive", row.Source
                ]));
            }

            await JS.InvokeVoidAsync("downloadCsv", "resources.csv", sb.ToString());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));
}
