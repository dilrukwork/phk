@page "/admin/owners"
@using System.Text
@inject OwnerAdminService AdminService
@inject OwnerImportService ImportService
@inject SubscriptionLookupService SubscriptionLookup
@inject IJSRuntime JS

<PageTitle>Owners</PageTitle>

<h1>Owners</h1>

<div class="toolbar">
    <label class="subscription-label">
        Subscription:
        <select class="form-input subscription-select" @bind="_selectedSubscriptionId">
            <option value="@OwnerImportService.AllSubscriptions">All subscriptions</option>
            @foreach (var sub in _subscriptions)
            {
                <option value="@sub.AzureSubscriptionId">@sub.SubscriptionName</option>
            }
        </select>
    </label>

    <button class="btn btn-primary" @onclick="RefreshFromAzure" disabled="@_refreshing">
        @(_refreshing ? "Refreshing..." : "Refresh from Azure")
    </button>

    <button class="btn btn-export" @onclick="ExportCsvAsync">⬇ Export CSV</button>
</div>

@if (_refreshStatus is not null)
{
    <p class="status-text">@_refreshStatus</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Owner Name</th>
                <th>Resources</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _owners)
            {
                <tr>
                    @if (_editingId == row.Id)
                    {
                        <td><input class="form-input" @bind="_editName" /></td>
                        <td>@row.ResourceCount</td>
                        <td>
                            <button class="btn-link" @onclick="SaveEdit">Save</button>
                            <button class="btn-link" @onclick="CancelEdit">Cancel</button>
                        </td>
                    }
                    else
                    {
                        <td>@row.OwnerName</td>
                        <td>@row.ResourceCount</td>
                        <td>
                            <button class="btn-link" @onclick="() => StartEdit(row)">Edit</button>
                            <button class="btn-link text-danger"
                                    @onclick="() => DeleteAsync(row)"
                                    disabled="@(row.ResourceCount > 0)"
                                    title="@(row.ResourceCount > 0 ? $"Cannot delete — {row.ResourceCount} resource(s) reference this owner" : "Delete")">
                                Delete
                            </button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@if (_showReviewModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h2>Review new owner names</h2>
            <p>
                @_alreadyKnownCount already-known name(s) were applied automatically.
                Specify the correct name for each new raw value below.
            </p>

            <table class="table">
                <thead>
                    <tr>
                        <th>Raw value (from Azure)</th>
                        <th>Canonical name</th>
                        <th>Include</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _newItems)
                    {
                        <tr>
                            <td>@item.RawValue</td>
                            <td><input class="form-input" @bind="item.CanonicalName" /></td>
                            <td><input type="checkbox" @bind="item.Include" /></td>
                        </tr>
                    }
                </tbody>
            </table>

            <details class="existing-names-reference">
                <summary>Existing owner names (for reference, @_owners.Count total)</summary>
                <ul>
                    @foreach (var owner in _owners)
                    {
                        <li>@owner.OwnerName</li>
                    }
                </ul>
            </details>

            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="ApproveImportAsync">Approve &amp; Import</button>
                <button class="btn-link" @onclick="CancelReview">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<OwnerRow> _owners = [];
    private List<SubscriptionOption> _subscriptions = [];
    private string _selectedSubscriptionId = OwnerImportService.AllSubscriptions;
    private bool _loading = true;
    private string? _error;

    private int? _editingId;
    private string _editName = string.Empty;

    private bool _refreshing;
    private string? _refreshStatus;

    private bool _showReviewModal;
    private List<RawValueReviewItem> _newItems = [];
    private int _alreadyKnownCount;
    private RawValueRefreshResult? _pendingResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _subscriptions = await SubscriptionLookup.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _owners = await AdminService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(OwnerRow row)
    {
        _editingId = row.Id;
        _editName = row.OwnerName;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEdit()
    {
        if (_editingId is null) return;
        try
        {
            await AdminService.UpdateAsync(_editingId.Value, _editName);
            _editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(OwnerRow row)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{row.OwnerName}'? This cannot be undone.");
        if (!confirmed) return;

        var (success, error) = await AdminService.DeleteAsync(row.Id);
        if (!success)
        {
            _error = error;
            return;
        }

        await LoadAsync();
    }

    private async Task RefreshFromAzure()
    {
        _refreshing = true;
        _error = null;
        _refreshStatus = "Fetching resources from Azure...";
        StateHasChanged();

        try
        {
            var result = await ImportService.PreviewImportAsync(_selectedSubscriptionId);
            _pendingResult = result;
            _newItems = result.NewItems;
            _alreadyKnownCount = result.AlreadyMappedCanonicalNames.Count;

            if (_newItems.Count == 0)
            {
                var created = await ImportService.ImportApprovedAsync(result);
                _refreshStatus = $"No new owner names found. {_alreadyKnownCount} already-known name(s) confirmed" +
                                  (created > 0 ? $", {created} re-created." : ".");
                _pendingResult = null;
                await LoadAsync();
            }
            else
            {
                _showReviewModal = true;
                _refreshStatus = null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _refreshStatus = null;
        }
        finally
        {
            _refreshing = false;
        }
    }

    private void CancelReview()
    {
        _showReviewModal = false;
        _newItems = [];
        _pendingResult = null;
    }

    private async Task ApproveImportAsync()
    {
        if (_pendingResult is null) return;

        try
        {
            var created = await ImportService.ImportApprovedAsync(_pendingResult);
            _showReviewModal = false;
            _refreshStatus = $"Imported {created} new owner(s). {_alreadyKnownCount} already-known name(s) confirmed.";
            _newItems = [];
            _pendingResult = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine(CsvRow(["Owner Name", "Resources"]));

        foreach (var row in _owners)
        {
            sb.AppendLine(CsvRow([row.OwnerName, row.ResourceCount.ToString()]));
        }

        await JS.InvokeVoidAsync("downloadCsv", "owners.csv", sb.ToString());
    }

    private static string CsvRow(IEnumerable<string> cells) =>
        string.Join(",", cells.Select(c => $"\"{c.Replace("\"", "\"\"")}\""));
}
