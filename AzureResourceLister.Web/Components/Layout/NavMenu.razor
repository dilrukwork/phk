<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <span class="navbar-brand">Azure Resource Lister</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <div class="nav-link admin-toggle" @onclick="ToggleSavings">
                Saving Strategies <span class="caret">@(_savingsExpanded ? "▾" : "▸")</span>
            </div>
        </div>

        @if (_savingsExpanded)
        {
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="savings/licensing">
                    Licensing
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="savings/unattacheddisks">
                    Unattached Disks
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <div class="nav-link admin-toggle" @onclick="ToggleAdmin">
                Admin <span class="caret">@(_adminExpanded ? "▾" : "▸")</span>
            </div>
        </div>

        @if (_adminExpanded)
        {
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/applications">
                    Applications
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/owners">
                    Owners
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/resources">
                    Resources
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/meters">
                    Meters
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/resourcecosts">
                    Resource Costs
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/costexceptions">
                    Cost Exceptions
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/sharedappimport">
                    Shared App Import
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/sharedappimportexceptions">
                    Shared App Exceptions
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/savingsplan">
                    Savings Plan
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="admin/reservedinstances">
                    Reserved Instances
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <div class="nav-link admin-toggle" @onclick="ToggleReports">
                Reports <span class="caret">@(_reportsExpanded ? "▾" : "▸")</span>
            </div>
        </div>

        @if (_reportsExpanded)
        {
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="reports/applications">
                    Applications
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="reports/resources">
                    Resources
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub">
                <NavLink class="nav-link" href="reports/subscriptions">
                    Subscriptions
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool _adminExpanded   = true;
    private bool _reportsExpanded = true;
    private bool _savingsExpanded = true;

    private void ToggleAdmin()   => _adminExpanded   = !_adminExpanded;
    private void ToggleReports() => _reportsExpanded = !_reportsExpanded;
    private void ToggleSavings() => _savingsExpanded = !_savingsExpanded;
}
