<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AzureResourceLister.Web</RootNamespace>
    <AssemblyName>AzureResourceLister.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureResourceLister.Core\AzureResourceLister.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed so EF Core design-time tooling (Add-Migration etc.) works when
         this project is selected as the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File"  Version="6.0.0" />
  </ItemGroup>

</Project>
